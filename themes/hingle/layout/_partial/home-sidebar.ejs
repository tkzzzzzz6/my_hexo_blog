<%
/**
 * 首页左右侧栏。
 *
 * 首页 grid 的左右两列。每列只有一个 sticky 盒子，内部按内容流排列。
 * Live2D 创建后由 home-sidebar.js 移入左盒舞台，不再独立 fixed。
 * 窄屏整体收起；右盒中的旧月份仍可展开，长内容由整个盒子滚动。
 *
 * 注意：hexo 的 list_archives 不支持 limit 参数，只能拿到完整 HTML，
 * 所以这里渲染两次（一次截断、一次完整）再交给前端折叠。
 */
const TIMELINE_LIMIT = 12;

const monthList = () => list_archives({
    show_count: false,
    type: 'monthly',
    order_by: '-date'
});

const fullHtml = monthList();

// 把完整列表切成 <li> 数组，前 12 条直接显示，其余放进「展开更多」
const items = (fullHtml.match(/<li\b[\s\S]*?<\/li>/g) || []);
const visible = items.slice(0, TIMELINE_LIMIT);
const hidden = items.slice(TIMELINE_LIMIT);
const hasMore = hidden.length > 0;

const wrapList = arr => arr.length
    ? `<ul class="archive-list">${arr.join('')}</ul>`
    : '';

// 最新文章：过滤掉题解（source/_posts/daily/ 下的文章），与首页正文口径一致。
// 不能用 list_posts()，那个 helper 不支持过滤；这里手拼与它完全相同的 DOM，
// 只是把 .post-list-item 的样式原样复用。
const recentHtml = (() => {
    const recent = site.posts.filter(post => !is_daily(post)).sort('-date').limit(6);
    const items = recent.map(post => [
        '<li class="post-list-item">',
        `<a class="post-list-link" href="${url_for(post.path)}">`,
        post.title || post.slug,
        '</a>',
        '</li>'
    ].join('')).join('');

    return `<ul class="post-list">${items}</ul>`;
})();
%>
<% if (side === "left") { %>
<aside class="home-side home-side-left" aria-label="最新文章与看板娘">
  <div class="home-side-box">
    <!-- 左上：最新文章 -->
    <section class="side-card side-recent">
        <h3 class="side-title"><i class="fa fa-file-text-o"></i>最新文章</h3>
        <%- recentHtml %>
    </section>

    <div class="side-live2d-stage" aria-hidden="true"></div>
  </div>
</aside>
<% } else { %>
<aside class="home-side home-side-right" aria-label="归档与标签">
  <div class="home-side-box">
    <!-- 右上：时光机（最近 12 个月，超出折叠） -->
    <section class="side-card side-timeline">
        <h3 class="side-title"><i class="fa fa-history"></i>时光机</h3>
        <%- wrapList(visible) %>
        <% if (hasMore) { %>
        <button type="button" class="side-more" aria-expanded="false">展开更多</button>
        <div class="side-timeline-rest" hidden><%- wrapList(hidden) %></div>
        <% } %>
    </section>

    <!-- 右下：标签云 -->
    <section class="side-card side-tags">
        <h3 class="side-title"><i class="fa fa-tags"></i>标签云</h3>
        <%- tagcloud() %>
    </section>
  </div>
</aside>
<% } %>
