<main class="home-page">
    <div class="home-layout">
        <%- partial("_partial/home-sidebar", { side: "left" }) %>
        <div class="wrap min home-content">
            <section class="home-title">
                <h1><%= config.title %></h1>
                <span><%= config.description %></span>
                <%- partial("_partial/social") %>
            </section>
            <%- partial("_partial/archive-list") %>
            <%- partial("_partial/daily-entry") %>
            <section class="page-navigator">
                <%- paginator({
                    prev_text: "«",
                    next_text: "»"
                }) %>
            </section>
        </div>
        <%- partial("_partial/home-sidebar", { side: "right" }) %>
    </div>
    <%- live2d() %>
    <%- js("static/home-sidebar.js") %>
</main>
